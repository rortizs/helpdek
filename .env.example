# 22/10/2026 - Richard Ortiz: plantilla de configuracion de HelpDesk EDU (semana 17).
# Copia este archivo a `.env` (cp .env.example .env) y completa los valores. `.env` NUNCA se sube a Git:
# esta en .gitignore y en .dockerignore. Aqui solo van valores de ejemplo, nunca secretos reales.
#
# Quien lee que:
#   - uvicorn en tu maquina:  uv run uvicorn app.main:app --env-file .env   (lee todo lo de este archivo)
#   - docker compose:         lee este mismo archivo para los ${...} de docker-compose.yml y arma
#                             DATABASE_URL por su cuenta (el host de la base ahi es `db`, no `localhost`).

# ---------------------------------------------------------------- secretos (OBLIGATORIOS)
# Clave que firma los tokens. La app NO arranca sin ella (minimo 32 caracteres). Genera una propia:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Contrasena del usuario de PostgreSQL. Cambia el valor de ejemplo. Solo se aplica cuando el volumen de la
# base esta vacio (la primera vez); si ya existe el volumen, la base conserva la contrasena con la que nacio.
# Usa solo letras, numeros, guion y guion bajo: va dentro de una URL (DATABASE_URL) y los simbolos la romperian.
POSTGRES_PASSWORD=cambia-esta-clave

# ---------------------------------------------------------------- base de datos
# Usada por uvicorn en tu maquina (la contrasena debe ser la misma que POSTGRES_PASSWORD). Docker la ignora.
DATABASE_URL=postgresql+psycopg://helpdesk:cambia-esta-clave@localhost:5433/helpdesk
# Base SOLO para pytest (se borra y se recrea en cada corrida). Su nombre debe contener "test".
TEST_DATABASE_URL=postgresql+psycopg://helpdesk:cambia-esta-clave@localhost:5433/helpdesk_test
# Opcionales de docker compose (valores por defecto entre parentesis)
# POSTGRES_DB=helpdesk        (helpdesk)
# POSTGRES_USER=helpdesk      (helpdesk)
# DB_PORT=5433                (5433: puerto de TU maquina hacia la base; solo escucha en 127.0.0.1)
# APP_PORT=8000               (8000: puerto de TU maquina hacia la API y el cliente web)

# ---------------------------------------------------------------- aplicacion
APP_NAME=HelpDesk EDU
# true devuelve los detalles de los errores 500 al cliente: SOLO en tu maquina, nunca desplegado.
DEBUG=false
# Zona horaria de la aplicacion y de la base (fechas, vencimientos de SLA).
APP_TIMEZONE=America/Guatemala
# Minutos de vida del token de acceso.
ACCESS_TOKEN_MINUTES=60

# ---------------------------------------------------------------- red y logs (semana 17)
# Origenes que pueden llamar a la API desde OTRO origen, separados por coma. Vacio = solo el mismo origen,
# que es lo que necesita el cliente de /app. Ejemplo si sirves el cliente con `python -m http.server 5500`:
#   CORS_ORIGINS=http://localhost:5500
# Nunca "*": la app se niega a arrancar.
CORS_ORIGINS=
# Nivel minimo de los logs: DEBUG, INFO, WARNING, ERROR o CRITICAL.
LOG_LEVEL=INFO
