# Clave para firmar tokens. OBLIGATORIA (la app no arranca sin ella).
# Genera una propia: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Nunca la subas a Git: .env ya esta en .gitignore.
SECRET_KEY=
# Minutos de vida del token de acceso.
ACCESS_TOKEN_MINUTES=60
